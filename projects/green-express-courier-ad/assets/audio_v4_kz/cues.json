 "lines": [
  {
   "id": "K1",
   "text": "Икемді кестемен қосымша жұмыс іздеп жүрсің бе?",
   "file": "vo/K1.wav",
   "start": 0.15,
   "gain_db": 0
  },
  {
   "id": "K2",
   "text": "Яндекс Еда курьері бол!",
   "file": "vo/K2.wav",
   "start": 2.75,
   "gain_db": 0
  },
  {
   "id": "K3",
   "text": "Өзіңе ыңғайлы кезде шығасың — күндіз де, түнде де.",
   "file": "vo/K3.wav",
   "start": 4.95,
   "gain_db": 0
  },
  {
   "id": "K4",
   "text": "Жаяу, велосипедпен немесе көлікпен — қалауың бойынша.",
   "file": "vo/K4.wav",
   "start": 8.5,
   "gain_db": 0
  },
  {
   "id": "K5",
   "text": "Бүгін еңбек еттің — бүгін ақшаңды алдың!",
   "file": "vo/K5.wav",
   "start": 12.9,
   "gain_db": 0
  },
  {
   "id": "K6",
   "text": "Он сегіз жастан бастап бәрін тіркейміз — рәсімдеуге көмектесеміз!",
   "file": "vo/K6.wav",
   "start": 15.8,
   "gain_db": 0
  },
  {
   "id": "K7",
   "text": "Тәжірибесіз, тегін, он бес минутта!",
